# Optional. Vercel provides the production URL automatically.
# Set only when you want to override it with your public domain, then redeploy.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Public provisional names. These do not enable a real practice or integrations.
NEXT_PUBLIC_PRODUCT_NAME=Asistente Dental
NEXT_PUBLIC_PRACTICE_NAME=Consultorio Demo

# Optional real verification. Defaults to OFF. No values below are credentials.
# Follow docs/verification-setup.md before enabling. Server-side secrets must
# NEVER have a NEXT_PUBLIC_ prefix. Local fictional mode needs none of these.
CONTACT_VERIFICATION_ENABLED=false
CONTACT_PRIVACY_REVIEWED=false
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_COUNTRY=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=
VERIFICATION_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
VERIFICATION_EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
